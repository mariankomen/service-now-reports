        <name>Get All</name>
        <operation_script><![CDATA[(function process(request, response) {
    try {
        var gr = new GlideRecord('x_1955226_connecto_folder');
        gr.query();

        var folders = [];
        while (gr.next()) {
            folders.push({
                sys_id: gr.getValue('sys_id'),
                name: gr.getValue('name'),
                parent_folder_id: gr.getValue('parent_folder_id'),
                uniqueid: gr.getValue('uniqueid')
            });
        }

        response.setStatus(200);
        response.setBody({ success: true, folders });

    } catch (err) {
        response.setStatus(500);
        response.setBody({ success: false, message: err.message });
    }
})(request, response);]]></operation_script>
